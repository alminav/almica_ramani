{
  "version": 8,
  "name": "Basic",
  "metadata": {
    "mapbox:autocomposite": false,
    "mapbox:type": "template",
    "maputnik:renderer": "mbgljs",
    "openmaptiles:version": "3.x",
    "openmaptiles:mapbox:owner": "openmaptiles",
    "openmaptiles:mapbox:source:url": "mapbox://openmaptiles.4qljc88t"
  },
  "sources": {
    "openmaptiles-planet": {
      "type": "vector",
      "url": "mbtiles:////data/user/0/com.almica.ramani/files/mvt/planet.mbtiles"
    }
  },
  "sprite": "asset://sprites/sprite",
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "rgba(243, 229, 187, 1)"}
    },
    {
      "id":  "planet-water",
      "type": "fill",
      "source": "openmaptiles-planet",
      "source-layer": "water",
      "filter": [
        "all",
        ["==", "$type", "Polygon"],
        ["!=", "intermittent", 1],
        ["!=", "brunnel", "tunnel"]
      ],
      "layout": {"visibility": "visible"},
      "paint": {"fill-color": "hsl(205, 56%, 73%)"}
    },
    {
      "id":  "planet-water_intermittent",
      "type": "fill",
      "source": "openmaptiles-planet",
      "source-layer": "water",
      "filter": ["all", ["==", "$type", "Polygon"], ["==", "intermittent", 1]],
      "layout": {"visibility": "visible"},
      "paint": {"fill-color": "hsl(205, 56%, 73%)", "fill-opacity": 0.7}
    },
    {
      "id":  "planet-tunnel_railway_transit",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "minzoom": 0,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "brunnel", "tunnel"],
        ["==", "class", "transit"]
      ],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "hsl(34, 12%, 66%)",
        "line-dasharray": [3, 3],
        "line-opacity": {"base": 1, "stops": [[11, 0], [16, 1]]}
      }
    },
    {
      "id":  "planet-road_area_pier",
      "type": "fill",
      "metadata": {},
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": ["all", ["==", "$type", "Polygon"], ["==", "class", "pier"]],
      "layout": {"visibility": "visible"},
      "paint": {"fill-antialias": true, "fill-color": "hsl(47, 26%, 88%)"}
    },
    {
      "id":  "planet-road_pier",
      "type": "line",
      "metadata": {},
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": ["all", ["==", "$type", "LineString"], ["in", "class", "pier"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "hsl(47, 26%, 88%)",
        "line-width": {"base": 1.2, "stops": [[15, 1], [17, 4]]}
      }
    },
    {
      "id":  "planet-road_bridge_area",
      "type": "fill",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "Polygon"],
        ["in", "brunnel", "bridge"]
      ],
      "layout": {},
      "paint": {"fill-color": "hsl(47, 26%, 88%)", "fill-opacity": 0.5}
    },
    {
      "id":  "planet-road_path",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "path", "track"]
      ],
      "layout": {"line-cap": "square", "line-join": "bevel"},
      "paint": {
        "line-color": "rgba(65, 40, 40, 1)",
        "line-dasharray": [1, 1],
        "line-width": {"stops": [[4, 0.25], [20, 10]], "base": 1.3}
      }
    },
    {
      "id":  "planet-road_minor",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "minor", "service"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "rgba(103, 111, 64, 1)",
        "line-width": {"base": 1.55, "stops": [[4, 0.25], [20, 30]]}
      }
    },
    {
      "id":  "planet-tunnel_minor",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "brunnel", "tunnel"],
        ["==", "class", "minor_road"]
      ],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#efefef",
        "line-dasharray": [0.36, 0.18],
        "line-width": {"base": 1.55, "stops": [[4, 0.25], [20, 30]]}
      }
    },
    {
      "id":  "planet-tunnel_major",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "brunnel", "tunnel"],
        ["in", "class", "primary", "secondary", "tertiary", "trunk"]
      ],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#fff",
        "line-dasharray": [0.28, 0.14],
        "line-width": {"base": 1.4, "stops": [[6, 0.5], [20, 30]]}
      }
    },
    {
      "id":  "planet-road_trunk_primary",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "trunk", "primary"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "rgba(179, 98, 35, 1)",
        "line-width": {"base": 1.3, "stops": [[6, 0.5], [20, 30]]}
      }
    },
    {
      "id":  "planet-road_secondary_tertiary",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["in", "class", "secondary", "tertiary"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "rgba(173, 164, 61, 1)",
        "line-width": {"base": 1.25, "stops": [[6, 0.5], [20, 20]]}
      }
    },
    {
      "id":  "planet-road_major_motorway",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "class", "motorway"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "rgba(222, 127, 127, 1)",
        "line-offset": 0,
        "line-width": {"base": 1.5, "stops": [[8, 1], [16, 10]]}
      }
    },
    {
      "id":  "planet-railway-transit",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "class", "transit"],
        ["!=", "brunnel", "tunnel"]
      ],
      "layout": {"visibility": "visible"},
      "paint": {
        "line-color": "hsl(34, 12%, 66%)",
        "line-opacity": {"base": 1, "stops": [[11, 0], [16, 1]]}
      }
    },
    {
      "id":  "planet-railway",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "layout": {"visibility": "visible"},
      "paint": {
        "line-color": "hsl(34, 12%, 66%)",
        "line-opacity": {"base": 1, "stops": [[11, 0], [16, 1]]}
      }
    },
    {
      "id":  "planet-bridge_minor case",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "brunnel", "bridge"],
        ["==", "class", "minor_road"]
      ],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#dedede",
        "line-gap-width": {"base": 1.55, "stops": [[4, 0.25], [20, 30]]},
        "line-width": {"base": 1.6, "stops": [[12, 0.5], [20, 10]]}
      }
    },
    {
      "id":  "planet-bridge_major case",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "brunnel", "bridge"],
        ["in", "class", "primary", "secondary", "tertiary", "trunk"]
      ],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#dedede",
        "line-gap-width": {"base": 1.55, "stops": [[4, 0.25], [20, 30]]},
        "line-width": {"base": 1.6, "stops": [[12, 0.5], [20, 10]]}
      }
    },
    {
      "id":  "planet-bridge_minor",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "brunnel", "bridge"],
        ["==", "class", "minor_road"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#efefef",
        "line-width": {"base": 1.55, "stops": [[4, 0.25], [20, 30]]}
      }
    },
    {
      "id":  "planet-bridge_major",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        ["==", "brunnel", "bridge"],
        ["in", "class", "primary", "secondary", "tertiary", "trunk"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fff",
        "line-width": {"base": 1.4, "stops": [[6, 0.5], [20, 30]]}
      }
    },
    {
      "id":  "planet-admin_sub",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "boundary",
      "filter": ["in", "admin_level", 4, 6, 8],
      "layout": {"visibility": "visible"},
      "paint": {"line-color": "hsla(0, 0%, 60%, 0.5)", "line-dasharray": [2, 1]}
    },
    {
      "id":  "planet-admin_country_z0-4",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "boundary",
      "minzoom": 0,
      "maxzoom": 5,
      "filter": [
        "all",
        ["<=", "admin_level", 2],
        ["==", "$type", "LineString"],
        ["!has", "claimed_by"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "hsl(0, 0%, 60%)",
        "line-width": {"base": 1.3, "stops": [[3, 0.5], [22, 15]]}
      }
    },
    {
      "id":  "planet-admin_country_z5-",
      "type": "line",
      "source": "openmaptiles-planet",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": [
        "all",
        ["<=", "admin_level", 2],
        ["==", "$type", "LineString"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "hsl(0, 0%, 60%)",
        "line-width": {"base": 1.3, "stops": [[3, 0.5], [22, 15]]}
      }
    },
    {
      "id":  "planet-place_label_other",
      "type": "symbol",
      "source": "openmaptiles-planet",
      "source-layer": "place",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", "$type", "Point"],
        ["!in", "class", "city", "state", "country", "continent"]
      ],
      "layout": {
        "text-anchor": "center",
        "text-field": "{name:latin}\n{name:nonlatin}",
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 6,
        "text-size": {"stops": [[6, 10], [12, 14]]},
        "visibility": "visible"
      },
      "paint": {
        "text-color": "hsl(0, 0%, 25%)",
        "text-halo-blur": 0,
        "text-halo-color": "hsl(0, 0%, 100%)",
        "text-halo-width": 2
      }
    },
    {
      "id":  "planet-place_label_city",
      "type": "symbol",
      "source": "openmaptiles-planet",
      "source-layer": "place",
      "maxzoom": 16,
      "filter": ["all", ["==", "$type", "Point"], ["==", "class", "city"]],
      "layout": {
        "text-field": "{name:latin}\n{name:nonlatin}",
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 10,
        "text-size": {"stops": [[3, 12], [8, 16]]}
      },
      "paint": {
        "text-color": "hsl(0, 0%, 0%)",
        "text-halo-blur": 0,
        "text-halo-color": "hsla(0, 0%, 100%, 0.75)",
        "text-halo-width": 2
      }
    },
    {
      "id":  "planet-country_label-other",
      "type": "symbol",
      "source": "openmaptiles-planet",
      "source-layer": "place",
      "maxzoom": 12,
      "filter": [
        "all",
        ["==", "$type", "Point"],
        ["==", "class", "country"],
        ["!has", "iso_a2"]
      ],
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 10,
        "text-size": {"stops": [[3, 12], [8, 22]]},
        "visibility": "visible"
      },
      "paint": {
        "text-color": "hsl(0, 0%, 13%)",
        "text-halo-blur": 0,
        "text-halo-color": "rgba(255,255,255,0.75)",
        "text-halo-width": 2
      }
    },
    {
      "id":  "planet-country_label",
      "type": "symbol",
      "source": "openmaptiles-planet",
      "source-layer": "place",
      "maxzoom": 12,
      "filter": [
        "all",
        ["==", "$type", "Point"],
        ["==", "class", "country"],
        ["has", "iso_a2"]
      ],
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Bold"],
        "text-max-width": 10,
        "text-size": {"stops": [[3, 12], [8, 22]]},
        "visibility": "visible"
      },
      "paint": {
        "text-color": "hsl(0, 0%, 13%)",
        "text-halo-blur": 0,
        "text-halo-color": "rgba(255,255,255,0.75)",
        "text-halo-width": 2
      }
    }
  ],
  "id":  "planet-basic"
}
